<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.TaskMapper">

    <resultMap type="com.example.entity.Task" id="TaskResultMap">
        <id property="id" column="id"/>
        <result property="taskId" column="task_id"/>
        <result property="taskType" column="task_type"/>
        <result property="materialType" column="material_type"/>
        <result property="quantity" column="quantity"/>
        <result property="startPoint" column="start_point"/>
        <result property="endPoint" column="end_point"/>
        <result property="agvId" column="agv_id"/>
        <result property="status" column="status"/>
        <result property="priority" column="priority"/>
        <result property="createTime" column="create_time"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="needTime" column="need_time"/>
    </resultMap>

    <!-- 插入任务 -->
    <insert id="insert" parameterType="com.example.entity.Task">
        INSERT INTO task (task_id, task_type, material_type, quantity,
                          start_point, end_point, agv_id, status, priority,
                          create_time, start_time, end_time, need_time)
        VALUES (#{taskId}, #{taskType}, #{materialType}, #{quantity},
                #{startPoint}, #{endPoint}, #{agvId}, #{status}, #{priority},
                #{createTime}, #{startTime}, #{endTime}, #{needTime})
    </insert>

    <!-- 更新任务 -->
    <update id="updateById" parameterType="com.example.entity.Task">
        UPDATE task
        SET task_type = #{taskType},
            material_type = #{materialType},
            quantity = #{quantity},
            start_point = #{startPoint},
            end_point = #{endPoint},
            agv_id = #{agvId},
            status = #{status},
            priority = #{priority},
            start_time = #{startTime},
            end_time = #{endTime},
            need_time = #{needTime}
        WHERE id = #{id}
    </update>

    <!-- 根据ID删除任务 -->
    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM task WHERE id = #{id}
    </delete>

    <!-- 根据ID查询任务 -->
    <select id="selectById" parameterType="java.lang.Integer" resultMap="TaskResultMap">
        SELECT * FROM task WHERE id = #{id}
    </select>

    <!-- 查询所有任务（带条件） -->
    <select id="selectAll" parameterType="com.example.entity.Task" resultMap="TaskResultMap">
        SELECT * FROM task
        <where>
            <if test="taskId != null and taskId != ''">
                AND task_id LIKE CONCAT('%', #{taskId}, '%')
            </if>
            <if test="taskType != null and taskType != ''">
                AND task_type = #{taskType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="materialType != null and materialType != ''">
                AND material_type LIKE CONCAT('%', #{materialType}, '%')
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

</mapper>
